{
  "name": "cursor-meta-mcp",
  "version": "1.0.0",
  "description": "Local-only MCP server: browse Cursor chat history, steer IDE chats, and spawn/intercept local SDK agents",
  "type": "module",
  "bin": {
    "cursor-meta-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "CURSOR_META_HOME=\"${TMPDIR:-/tmp}/cursor-meta-test-$$\" node --import tsx scripts/run-with-worker-node.mjs --test --experimental-test-coverage --experimental-test-module-mocks --test-coverage-lines=79 --test-coverage-include=src/** --test-coverage-exclude=src/index.ts --test-coverage-exclude=src/history-store.ts --test-coverage-exclude=src/chat-activity.ts --test-coverage-exclude=src/agent-cli.ts --import tsx tests/*.test.ts",
    "test:fast": "CURSOR_META_HOME=\"${TMPDIR:-/tmp}/cursor-meta-test-$$\" node --import tsx scripts/run-with-worker-node.mjs --test --experimental-test-module-mocks --import tsx tests/*.test.ts",
    "test:files": "CURSOR_META_HOME=\"${TMPDIR:-/tmp}/cursor-meta-test-$$\" node --import tsx scripts/run-with-worker-node.mjs --test --experimental-test-module-mocks --import tsx",
    "test:coverage": "npm test",
    "test:logged": "node --import tsx scripts/run-tests-logged.mjs"
  },
  "keywords": [
    "mcp",
    "cursor",
    "cursor-history",
    "cursor-sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "cursor-history": "^0.9.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
