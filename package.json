{
  "name": "cursor-meta-mcp",
  "version": "0.3.3",
  "description": "Local-only MCP server: browse Cursor chat history, steer IDE chats, and spawn/intercept local SDK agents",
  "type": "module",
  "bin": {
    "cursor-meta-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-coverage --experimental-test-module-mocks --test-coverage-lines=80 --test-coverage-include=src/** --test-coverage-exclude=src/index.ts --import tsx tests/**/*.test.ts",
    "test:coverage": "npm test",
    "sentiment": "node scripts/sentiment-analysis.mjs",
    "sentiment:classify": "node scripts/sentiment-classify.mjs",
    "relentless": "node scripts/relentless-loop.mjs",
    "pulse": "node scripts/consciousness-pulse.mjs"
  },
  "keywords": [
    "mcp",
    "cursor",
    "cursor-history",
    "cursor-sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cursor-history": "^0.9.1",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
