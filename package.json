{
  "name": "cursor-meta-mcp",
  "version": "0.1.0",
  "description": "Local-only MCP server: browse Cursor chat history and spawn local SDK agents",
  "type": "module",
  "bin": {
    "cursor-meta-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/server.test.ts"
  },
  "keywords": [
    "mcp",
    "cursor",
    "cursor-history",
    "cursor-sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cursor-history": "^0.9.1",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
